{
	"schemaVersion": 1,
	"id": "pdapi",
	"version": "${version}",
	"name": "Pluto's Drinks API",
	"description": "A (not so) small little API for my Pluto's Drinks series",
	"authors": [
		"Pluto7073"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/pdapi",
		"sources": "https://github.com/pluto7073/PlutosDrinksAPI"
	},
	"license": "MIT",
	"icon": "assets/pdapi/icon.png",
	"accessWidener": "pdapi.classtweaker",
	"environment": "*",
	"entrypoints": {
		"main": [
			"ml.pluto7073.pdapi.PDAPI"
		],
		"client": [
			"ml.pluto7073.pdapi.client.PDAPIClient"
		],
		"rei_client": [
			"ml.pluto7073.pdapi.compat.rei.DrinkREI"
		],
		"modmenu": [
			"ml.pluto7073.pdapi.compat.modmenu.PDModMenu"
		]
	},
	"custom": {
		"modmenu": {
			"badges": [ "library" ],
			"update_checker": true,
			"parent": {
				"id": "plutosdrinks",
				"name": "Pluto's Drinks Series",
				"description": "Every mod in the Pluto's Drinks collection",
				"icon": "assets/pdapi/icon.png",
				"entrypoints": {
					"modmenu": [
						"ml.pluto7073.pdapi.compat.modmenu.PDModMenu"
					]
				}
			}
		}
	},
	"mixins": [
		"pdapi.mixins.json"
	],
	"depends": {
		"fabric": ">=0.18.0",
		"minecraft": "~1.20.5",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*",
		"dehydration": "*",
		"plutoscoffee": "*",
		"teatime": "*",
		"bartending": "*"
	},
	"breaks": {
		"plutoscoffee": ["<=3.0.6", "<=1.20.1+3.0"],
		"bartending": "<=0.6.1",
		"teatime": "<=1.0"
	}
}
